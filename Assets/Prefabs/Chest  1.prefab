  m_Name: 
  m_EditorClassIdentifier: 
  questionPanelPrefab: {fileID: 4932384610095576166, guid: cec51bf7528894feba7d2c4ef6b0332c, type: 3}
  questionPanelParent: {fileID: 0}
  currentLevelName: 1
  allLevelQuestions:
  - levelName: 1
    questions:
    - questionText: "B\u1EA1n h\xE3y cho bi\u1EBFt l\u1EDDi k\xEAu g\u1ECDi c\u1EA3
        n\u01B0\u1EDBc c\u1EE7a B\xE1c H\u1ED3: \u201CD\xF9 ph\u1EA3i chi\u1EBFn
        \u0111\u1EA5u 5 n\u0103m, 10 n\u0103m, 20 n\u0103m ho\u1EB7c l\xE2u h\u01A1n
        n\u1EEFa, ch\xFAng ta c\u0169ng ki\xEAn quy\u1EBFt chi\u1EBFn \u0111\u1EA5u
        \u0111\u1EBFn th\u1EAFng l\u1EE3i ho\xE0n to\xE0n\u201D \u0111\u01B0\u1EE3c
        ra \u0111\u1EDDi v\xE0o th\u1EDDi gian n\xE0o?"
      answers:
      - "Ng\xE0y 5/6/1965"
      - "Ng\xE0y 20/7/1965"
      - "Ng\xE0y 25/6/1965"
      - "Ng\xE0y 26/5/1965"
      correctAnswerIndex: 1
    - questionText: " L\xFAc 10h45p, ng\xE0y 30/4/1975, di\u1EC5n ra s\u1EF1 ki\u1EC7n
        c\u01A1 b\u1EA3n n\xE0o \u1EDF S\xE0i G\xF2n? "
      answers:
      - "D\u01B0\u01A1ng V\u0103n Minh \u0111\u1EA7u h\xE0ng"
      - "Xe t\u0103ng ti\u1EBFn v\xE0o Dinh \u0110\u1ED9c L\u1EADp"
      - "Chi\u1EBFn d\u1ECBch H\u1ED3 Ch\xED Minh to\xE0n th\u1EAFng"
      - "C\u1EAFm c\u1EDD tr\xEAn n\xF3c Dinh \u0110\u1ED9c L\u1EADp"
      correctAnswerIndex: 1
    - questionText: "Ph\u01B0\u01A1ng ch\xE2m \u0111\xE1nh m\xE0 B\u1ED9 Ch\xEDnh
        tr\u1ECB \u0111\u1EC1 ra trong k\u1EBF ho\u1EA1ch gi\u1EA3i ph\xF3ng mi\u1EC1n
        Nam l\xE0 g\xEC?"
      answers:
      - "\u201C\u0110\xE1nh nhanh, th\u1EAFng nhanh\u201D"
      - "\u201CT\xEDch c\u1EF1c, ch\u1EE7 \u0111\u1ED9ng, c\u01A1 \u0111\u1ED9ng,
        linh ho\u1EA1t\u201D"
      - "\u201C\u0110\xE1nh \u0103n ch\u1EAFc, \u0111\xE1nh ch\u1EAFc th\u1EAFng\u201D  "
      - "\u201CTh\u1EA7n t\u1ED1c, t\xE1o b\u1EA1o, b\u1EA5t ng\u1EDD, ch\u1EAFc
        th\u1EAFng\u201D"
      correctAnswerIndex: 3
    - questionText: "L\u1EF1c l\u01B0\u1EE3ng Qu\xE2n \u0111\u1ED9i Nh\xE2n d\xE2n
        Vi\u1EC7t Nam tham chi\u1EBFn trong tr\u1EADn Xu\xE2n L\u1ED9c do ai l\xE0m
        T\u01B0 L\u1EC7nh?"
      answers:
      - "Thi\u1EBFu t\u01B0\u1EDBng Ho\xE0ng Th\u1EBF Thi\u1EC7n"
      - "\u0110\u1EA1i t\u01B0\u1EDBng T\xF4 L\xE2m"
      - "Thi\u1EBFu t\u01B0\u1EDBng Ho\xE0ng C\u1EA7m  "
      - "Thi\u1EBFu t\u01B0\u1EDBng Ng\xF4 Quang Tr\u01B0\u1EDFng"
      correctAnswerIndex: 2
    - questionText: "Ch\u1EE7 t\u1ECBch H\u1ED3 Ch\xED Minh k\xFD v\u0103n b\u1EA3n
        n\xE0o quy \u0111\u1ECBnh quy\u1EC1n \u0111\u01B0\u1EE3c ngh\u1EC9 vi\u1EC7c
        ng\xE0y Qu\u1ED1c t\u1EBF Lao \u0111\u1ED9ng 1/5 v\xE0 \u0111\u01B0\u1EE3c
        h\u01B0\u1EDFng l\u01B0\u01A1ng nh\u01B0 ng\xE0y l\xE0m vi\u1EC7c?"
      answers:
      - "S\u1EAFc l\u1EC7nh 40"
      - "S\u1EAFc l\u1EC7nh 36"
      - "S\u1EAFc l\u1EC7nh 46"
      - "S\u1EAFc l\u1EC7nh 56"
      correctAnswerIndex: 3
    - questionText: "B\u1EA1n h\xE3y cho bi\u1EBFt chi\u1EBFc xe t\u0103ng d\u1EABn
        \u0111\u1EA7u \u0111\xE1nh chi\u1EBFm Dinh \u0111\u1ED9c l\u1EADp mang s\u1ED1
        bao nhi\xEAu?"
      answers:
      - 390
      - 429
      - 205
      - 309
      correctAnswerIndex: 0
    questionsToAnswer: 3
    nextSceneName: 2
