  questionPanelPrefab: {fileID: 4932384610095576166, guid: cec51bf7528894feba7d2c4ef6b0332c, type: 3}
  questionPanelParent: {fileID: 1331217292}
  questions:
  - questionText: "V\u1ECB t\u1ED5ng th\u1ED1ng cu\u1ED1i c\xF9ng c\u1EE7a ch\xEDnh
      quy\u1EC1n M\u0129 \u2013 Ng\u1EE5y, \u0111\xE3 \u0111\u1EA7u h\xE0ng v\xF4
      \u0111i\u1EC1u ki\u1EC7n khi qu\xE2n ta ti\u1EBFn v\xE0o Dinh \u0110\u1ED9c
      L\u1EADp?"
    answers:
    - "Ng\xF4 \u0110\xECnh Di\u1EC7m"
    - "Nguy\u1EC5n V\u0103n Thi\u1EC7u  "
    - "D\u01B0\u01A1ng V\u0103n Minh"
    - "Tr\u1EA7n V\u0103n H\u01B0\u01A1ng  "
    correctAnswerIndex: 2
  - questionText: "C\xF3 m\u1ED9t th\xE0nh ph\u1ED1 \u0111\u01B0\u1EE3c gi\u1EA3i
      ph\xF3ng v\xE0o ng\xE0y 26/3/1975 tr\xF9ng v\u1EDBi ng\xE0y th\xE0nh l\u1EADp
      \u0110o\xE0n TNCS H\u1ED3 Ch\xED Minh. B\u1EA1n h\xE3y cho bi\u1EBFt \u0111\xF3
      l\xE0 th\xE0nh ph\u1ED1 n\xE0o?"
    answers:
    - "\u0110\xE0 N\u1EB5ng"
    - "Hu\u1EBF"
    - "\u0110\u1EAFk L\u1EAFk"
    - "Bu\xF4n M\xEA Thu\u1ED9t"
    correctAnswerIndex: 1
  - questionText: "B\u1EA1n h\xE3y cho bi\u1EBFt chi\u1EBFc xe t\u0103ng d\u1EABn
      \u0111\u1EA7u \u0111\xE1nh chi\u1EBFm Dinh \u0111\u1ED9c l\u1EADp mang s\u1ED1
      bao nhi\xEAu?"
    answers:
    - 390
    - 429
    - 205
    - 309
    correctAnswerIndex: 0
